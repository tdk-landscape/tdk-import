{
  "name": "tdk-import",
  "version": "0.1.0",
  "description": "Scan a repo and import its Procfile, Compose, Dockerfile and package.json services into TDK service.json files.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tdk-import": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdk-landscape/tdk-import.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc --project tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
